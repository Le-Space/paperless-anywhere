#!/bin/sh
# paperless-fixed-address: the fixed address (#26), when the unlock brought a
# DNS token. The name (https_hostname) is the same at every start; this points
# it at the VM (paperless-dns-records), gets a certificate for it over DNS
# with lego (no port and no 2n6 needed for the challenge; every step that asks
# the network has a time limit), and has Caddy serve
# it on 443 and on the node's port (https_port), so `name:port` reaches the VM
# from IPv4 and from IPv6. An existing certificate (the VM's own, or with a
# restore the backup's, which is waited for) is renewed only when it has less
# than 30 days left; a new one is ordered only when there is none. Without the token, nothing
# happens here: paperless-https serves the 2n6 name with Caddy's own ACME.
#
# The token is needed for the records and the certificate only. When this
# ends, with the address ready or given up, the token is zeroed and removed;
# fixed-address.wanted tells paperless-https that this VM has a fixed address
# (it used to read that from the token), and fixed-address.done tells
# paperless-forget-passphrase to remove a token handed over again.
set -eu
s=/tmp/secrets
[ -s "$s/dns_cloudflare_token" ] || exit 0
state=/run/paperless-anywhere
mkdir -p "$state"
: > "$state/fixed-address.wanted"
forget_token() {
  f="$s/dns_cloudflare_token"
  size="$(stat -c %s "$f" 2>/dev/null || echo 0)"
  [ "$size" -gt 0 ] && dd if=/dev/zero of="$f" bs=1 count="$size" conv=notrunc 2>/dev/null
  rm -f "$f" "$state/cf-token"
  : > "$state/fixed-address.done"
}
trap forget_token EXIT
host="$(head -c 253 "$s/https_hostname" | tr -d '\r\n')"
ipv4="$(head -c 15 "$s/https_ipv4" | tr -d '\r\n')"
port="$(head -c 5 "$s/https_port" | tr -d '\r\n')"
case "$host" in *[!a-z0-9.-]*|"") echo "paperless-fixed-address: not a hostname" >&2; exit 1 ;; esac
case "$port" in *[!0-9]*|"") echo "paperless-fixed-address: not a port" >&2; exit 1 ;; esac
started=$(date +%s)
report() {
  printf '{"status":"%s","host":"%s","port":%s,"seconds":%s%s}\n' "$1" "$host" "$port" "$(( $(date +%s) - started ))" "${2:-}" > "$state/fixed-address.json.tmp" \
    && mv "$state/fixed-address.json.tmp" "$state/fixed-address.json"
}
# The certificate and the ACME account go into the sealed area only. Without
# it, the address is given up at once, and the status page (over the 2n6
# name, paperless-https --status) says why instead of a closed port.
report waiting ',"step":"data-area"'
/usr/local/sbin/paperless-require-sealed paperless-fixed-address || { report failed ',"step":"data-area","final":true'; exit 1; }
attempt() {
report dns
timeout 180 paperless-dns-records "$host" "$ipv4" || { report failed ',"step":"dns"'; return 1; }

# The certificate, in the sealed area (/etc/paperless-anywhere is bind-mounted
# from it). The token goes to lego as a file, not in its arguments.
dir=/etc/paperless-anywhere/tls
install -d -m 700 "$dir"
umask 077
tr -d '\r\n' < "$s/dns_cloudflare_token" > "$state/cf-token"
email="$(head -c 254 "$s/acme_email" 2>/dev/null | tr -d '\r\n')"
case "$email" in *@*.*) ;; *) email="paperless-anywhere@le-space.de" ;; esac
case "$email" in *[!A-Za-z0-9.@_+-]*) email="paperless-anywhere@le-space.de" ;; esac
crt="$dir/certificates/$host.crt"
key="$dir/certificates/$host.key"
# shellcheck disable=SC2086
order() {
  CLOUDFLARE_DNS_API_TOKEN_FILE="$state/cf-token" timeout 900 lego --accept-tos --email "$email" --dns cloudflare \
    --domains "$host" --path "$dir" --pem $1 >"$state/lego.log" 2>&1
}
# Which certificate, in this order:
#   1. one this VM has;
#   2. with a restore, the one in the backup: it is waited for before anything
#      is ordered. The name is the same at every start, and Let's Encrypt
#      issues at most five certificates per name and week (and fifty per week
#      for the whole domain, for everyone together): a start that ordered
#      first used one up each time, and from the sixth start in a week the
#      order was refused (2026-11-19). The app reads the start's progress over
#      the 2n6 name meanwhile (paperless-https --status);
#   3. a new one, ordered over DNS, only when there is none.
# A certificate from 1 or 2 is renewed when it has less than 30 days left; if
# that is refused and it is still valid, it is used as it is.
if ! { [ -s "$crt" ] && [ -s "$key" ]; } && { [ -s "$s/restore_ledger_entry" ] || [ -s "$state/restore-entry.env" ]; }; then
  report restore
  # At most two hours: the restore itself may hold its lock that long.
  timeout 7200 paperless-restore fetch || echo "paperless-fixed-address: no certificate from the backup" >&2
fi
report certificate
if [ -s "$crt" ] && [ -s "$key" ]; then
  if ! order "renew --days 30 --no-random-sleep"; then
    tail -5 "$state/lego.log" >&2
    if openssl x509 -checkend 3600 -noout -in "$crt" >/dev/null 2>&1; then
      echo "paperless-fixed-address: renewal refused; the certificate is used as it is" >&2
    else
      rm -f "$state/cf-token"; report failed ',"step":"certificate"'; return 1
    fi
  fi
elif ! order run; then
  rm -f "$state/cf-token"; report failed ',"step":"certificate"'; tail -5 "$state/lego.log" >&2; return 1
fi
rm -f "$state/cf-token"

# Caddy runs as its own user: it gets a copy it can read.
install -d -m 700 -o caddy -g caddy /var/lib/caddy/fixed
install -m 600 -o caddy -g caddy "$crt" /var/lib/caddy/fixed/cert.pem
install -m 600 -o caddy -g caddy "$key" /var/lib/caddy/fixed/key.pem
paperless-https --early "$host"
report ready ",\"notAfter\":\"$(openssl x509 -noout -enddate -in "$crt" 2>/dev/null | sed 's/^notAfter=//')\""
}
# A few tries, a minute apart: Let's Encrypt refuses a name for an hour after
# five failed validations, so it does not keep trying. Each try runs in a
# subshell of its own with `set -e`: called as `attempt && …` the shell would
# ignore `set -e` inside it, and a failed step would still end in "ready".
# (The subshell does not inherit the EXIT trap; the token stays for the next try.)
for i in 1 2 3 4; do
  set +e
  (set -e; attempt)
  ok=$?
  set -e
  [ "$ok" = 0 ] && exit 0
  [ "$i" = 4 ] || sleep 60
done
# Given up: "final" tells the status page (and the app) that the fixed name
# will not answer on this start; until then a failed try is retried.
step="$(sed -n 's/.*"step":"\([a-z-]*\)".*/\1/p' "$state/fixed-address.json" 2>/dev/null)"
report failed ",\"step\":\"${step:-certificate}\",\"final\":true"
exit 1
