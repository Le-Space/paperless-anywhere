#!/bin/sh
# paperless-restore: import a backup into the empty Paperless, once, after the
# unlock. What to restore comes with the unlock, over the attested channel:
#
#   /tmp/secrets/restore_ledger_entry  one entry of paperless-backup-filecoin's
#                                      ledger.json (name, pieceCid, sealedSha256,
#                                      copies[].retrievalUrl; a backup in parts
#                                      also parts[] and copies[].retrievalUrls[]);
#                                      absent: nothing to do
#   /tmp/secrets/age_identity          the age identity that decrypts it
#   /tmp/secrets/paperless_role        "primary" keeps the imported mail rules on;
#                                      anything else ("test") switches them off,
#                                      since another instance reads that mailbox
#
# The piece is fetched from a provider, checked against the ledger's SHA-256,
# or its piece CID. A backup above 1 GB comes in parts (each a piece of at
# most 1,000,000,000 bytes): every part is fetched from the first copy that
# delivers it, checked by its size, SHA-256 and piece CID, appended in order,
# and the whole checked against the ledger's SHA-256 if it has one. Then it is
# decrypted with age as a stream (no copy in memory), unpacked and imported
# with document_importer. The identity is overwritten and removed afterwards,
# and so is every plaintext copy, whether the restore worked or not. The
# outcome goes to /run/paperless-anywhere/restore.json; document names stay in
# /var/log/paperless-anywhere/restore.log on the encrypted disk.
set -u
secrets=/tmp/secrets
state_dir=/run/paperless-anywhere
state="$state_dir/restore.json"
log_dir=/var/log/paperless-anywhere
work=/srv/paperless/export/restore   # /usr/src/paperless/export/restore in the container
mkdir -p "$state_dir" "$log_dir" /var/lib/paperless-anywhere
chmod 700 "$log_dir"
log="$log_dir/restore.log"

status() { # status <state> [extra json fields]
  printf '{"status":"%s","at":"%s"%s}\n' "$1" "$(date -u +%FT%TZ)" "${2:-}" > "$state.tmp" && mv "$state.tmp" "$state"
}
fail() {
  echo "paperless-restore: $*" >&2
  # What the log says, fit for the public status page: of an exception only
  # its class and errno, never its message, which may quote a document.
  why="$(python3 - "$log" <<'WHY' 2>/dev/null || true
import re, sys
try:
    lines = open(sys.argv[1], errors="replace").read().splitlines()
except OSError:
    lines = []
found = []
for l in lines:
    m = re.match(r"^((?:[A-Za-z_]\w*\.)*[A-Za-z_]\w*(?:Error|Exception|Interrupt|Exit))\b:?\s*(\[Errno \d+\] [A-Za-z ]+)?", l)
    if m:
        found.append(m.group(1) + (" " + m.group(2).strip() if m.group(2) else ""))
    elif re.search(r"Permission denied|No such file or directory|No space left", l):
        found.append(re.sub(r"(?<![\w:])/[^\s]+", "/…", re.sub(r"'[^']*'|\"[^\"]*\"", "'…'", l))[:160])
print(found[-1] if found else "")
WHY
)"
  status failed ",\"reason\":\"$(printf '%s' "$*" | tr -d '"\\\n' | cut -c1-200)\",\"error\":\"$(printf '%s' "$why" | tr -d '"\\\n' | cut -c1-200)\""
  exit 1
}
forget_secrets() {
  for f in "$secrets/age_identity" "$secrets/restore_ledger_entry"; do
    [ -e "$f" ] || continue
    size=$(stat -c %s "$f" 2>/dev/null || echo 0)
    dd if=/dev/zero of="$f" bs=1 count="$size" conv=notrunc 2>/dev/null
    rm -f "$f"
  done
}
cleanup() {
  forget_secrets
  rm -rf "$work"
}
# paperless-restore fetch: only fetch, check, decrypt and unpack, and put the
# fixed address's certificate in place (paperless-fixed-address asks for that
# before it would order a new one). It needs neither Docker nor Paperless.
# paperless-restore (run): the same if not done yet, then the import.
cmd="${1:-run}"
case "$cmd" in fetch|run) ;; *) echo "usage: paperless-restore [fetch|run]" >&2; exit 2 ;; esac
exec 8>"$state_dir/restore.lock"
flock 8
entry_env="$state_dir/restore-entry.env"   # name, provider, times: no secrets
[ "$cmd" = run ] && trap cleanup EXIT

fetch() {
[ -s "$work/import/manifest.json" ] && [ -s "$entry_env" ] && return 0
if [ ! -s "$secrets/restore_ledger_entry" ]; then
  # An earlier fetch that failed after the secrets were forgotten stays failed.
  grep -q '"status":"failed"' "$state" 2>/dev/null && exit 1
  status skipped ',"reason":"no restore_ledger_entry came with the unlock"'
  exit 0
fi
[ -s "$secrets/age_identity" ] || fail "a restore_ledger_entry came without an age_identity"
status running
t0=$(date +%s)

# The entry, read without a shell parser. It names the piece and where to get
# it; it may carry the ledger's SHA-256 (backups made on the Mac) or not (an
# entry the app found on chain): the piece CID is then the check.
# Read into a variable first: eval of an empty answer would succeed.
vars="$(python3 - "$secrets/restore_ledger_entry" <<'PY'
import json, re, shlex, sys
e = json.load(open(sys.argv[1]))
URL = r"https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9/._-]*"
CID = r"baga[a-z2-7]{20,}|bafk[a-z2-7]{20,}"
SHA = r"[0-9a-f]{64}"
sha = str(e.get("sealedSha256", "") or "")
cid = str(e.get("pieceCid", "") or "")
copies = [c for c in e.get("copies", []) if isinstance(c, dict)]
urls = [c.get("retrievalUrl", "") for c in copies]
urls = [u for u in urls if isinstance(u, str) and re.fullmatch(URL, u)]
if sha and not re.fullmatch(SHA, sha):
    sys.exit("the ledger entry's SHA-256 is malformed")
parts = e.get("parts") if isinstance(e.get("parts"), list) else []
plan = []
if len(parts) > 1:
    # A backup in parts: each part by its piece CID (and, from the ledger, its
    # SHA-256 and size), fetched from the URLs every copy has for that part.
    if len(parts) > 512:
        sys.exit("the ledger entry has too many parts")
    for i, p in enumerate(parts):
        p = p if isinstance(p, dict) else {}
        pcid = str(p.get("pieceCid", "") or "")
        psha = str(p.get("sha256", "") or "")
        psize = p.get("size")
        if not re.fullmatch(CID, pcid):
            sys.exit(f"part {i + 1} names no piece CID")
        if psha and not re.fullmatch(SHA, psha):
            sys.exit(f"the SHA-256 of part {i + 1} is malformed")
        if psize is not None and not (isinstance(psize, int) and 0 < psize <= 1_000_000_000):
            sys.exit(f"the size of part {i + 1} is not a part size")
        purls = []
        for c in copies:
            ru = c.get("retrievalUrls")
            u = ru[i] if isinstance(ru, list) and len(ru) == len(parts) else None
            if isinstance(u, str) and re.fullmatch(URL, u):
                purls.append(u)
        if not purls:
            sys.exit(f"part {i + 1} has no https retrieval URL")
        plan.append(" ".join([pcid, psha or "-", str(psize) if psize is not None else "-", *purls]))
    if cid != parts[0].get("pieceCid"):
        sys.exit("the pieceCid of the ledger entry is not its first part")
else:
    if not re.fullmatch(CID, cid) and not sha:
        sys.exit("the ledger entry names neither a piece CID nor a SHA-256")
    if not urls:
        sys.exit("the ledger entry has no https retrieval URL")
print("name=" + shlex.quote(str(e.get("name", "backup"))[:80]))
print("sha=" + shlex.quote(sha))
print("cid=" + shlex.quote(cid))
print("urls=" + shlex.quote(" ".join(urls)))
print("nparts=" + str(max(len(plan), 1)))
print("plan=" + shlex.quote("\n".join(plan)))
PY
)" || fail "unusable restore_ledger_entry"
eval "$vars"

rm -rf "$work" && mkdir -p "$work" && chmod 700 "$work"
t1=$(date +%s); got=""
if [ "$nparts" -gt 1 ]; then
  : > "$work/sealed.age"
  i=0
  # Not in a pipe: fail must end this shell, not a subshell.
  while read -r pcid psha psize purls; do
    i=$((i + 1)); pgot=""
    for u in $purls; do
      if curl -fsSL --retry 2 --max-time 1800 -o "$work/part.age" "$u"; then pgot="${u#https://}"; pgot="${pgot%%/*}"; break; fi
    done
    [ -n "$pgot" ] || fail "no provider delivered part $i of $nparts"
    [ -n "$got" ] || got="$pgot"
    if [ "$psize" != - ]; then
      [ "$(stat -c %s "$work/part.age")" = "$psize" ] || fail "part $i of $nparts has the wrong size"
    fi
    if [ "$psha" != - ]; then
      [ "$(sha256sum "$work/part.age" | cut -d' ' -f1)" = "$psha" ] || fail "part $i of $nparts does not match the ledger's SHA-256"
    fi
    got_cid="$(cd /opt/backup-filecoin && node piece-cid.mjs "$work/part.age" 2>>"$log")" || fail "could not compute the piece CID of part $i"
    [ "$got_cid" = "$pcid" ] || fail "part $i of $nparts is not the piece that was asked for"
    cat "$work/part.age" >> "$work/sealed.age" || fail "could not join part $i of $nparts"
    rm -f "$work/part.age"
  done <<PLAN
$plan
PLAN
  [ "$i" = "$nparts" ] || fail "only $i of $nparts parts were read"
  if [ -n "$sha" ]; then
    [ "$(sha256sum "$work/sealed.age" | cut -d' ' -f1)" = "$sha" ] || fail "the joined parts do not match the ledger's SHA-256"
  fi
else
  for u in $urls; do
    if curl -fsSL --retry 2 --max-time 1800 -o "$work/sealed.age" "$u"; then got="${u#https://}"; got="${got%%/*}"; break; fi
  done
  [ -n "$got" ] || fail "no provider delivered the piece"
  if [ -n "$sha" ]; then
    [ "$(sha256sum "$work/sealed.age" | cut -d' ' -f1)" = "$sha" ] || fail "the downloaded piece does not match the ledger's SHA-256"
  fi
  if [ -n "$cid" ]; then
    got_cid="$(cd /opt/backup-filecoin && node piece-cid.mjs "$work/sealed.age" 2>>"$log")" || fail "could not compute the piece CID"
    [ "$got_cid" = "$cid" ] || fail "the downloaded piece is not the piece that was asked for"
  fi
fi
t2=$(date +%s)

age -d -i "$secrets/age_identity" -o "$work/export.zip" "$work/sealed.age" 2>>"$log" || fail "age could not decrypt the piece"
forget_secrets
rm -f "$work/sealed.age"
t3=$(date +%s)

# The export into import/; what paperless-anywhere put beside it
# (.paperless-anywhere/: the fixed address's certificate) into extra/, never
# into what document_importer reads.
python3 - "$work/export.zip" "$work/import" "$work/extra" <<'PY' 2>>"$log" || fail "the export zip is broken or unsafe"
import os, sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
names = z.namelist()
bad = [n for n in names if n.startswith("/") or ".." in n.split("/")]
if bad or len(names) != len(set(names)) or "manifest.json" not in names or z.testzip() is not None:
    sys.exit("refused")
extra = ".paperless-anywhere/"
z.extractall(sys.argv[2], [n for n in names if not n.startswith(extra)])
for n in names:
    if n.startswith(extra) and not n.endswith("/"):
        out = os.path.join(sys.argv[3], n[len(extra):])
        os.makedirs(os.path.dirname(out), mode=0o700, exist_ok=True)
        with z.open(n) as src, open(out, "wb") as dst:
            os.chmod(out, 0o600)
            dst.write(src.read())
PY
rm -f "$work/export.zip"
# The certificate and the lego account, unless this VM already has its own.
if [ -d "$work/extra" ] && ! [ -d /etc/paperless-anywhere/tls/certificates ]; then
  install -d -m 700 /etc/paperless-anywhere/tls
  cp -a "$work/extra/." /etc/paperless-anywhere/tls/
fi
rm -rf "$work/extra"
printf 'name=%s\ngot=%s\nt0=%s\nt1=%s\nt2=%s\nt3=%s\n' "$(printf '%s' "$name" | tr -cd 'A-Za-z0-9._:-')" "$(printf '%s' "$got" | tr -cd 'A-Za-z0-9.:-')" "$t0" "$t1" "$t2" "$t3" > "$entry_env"
}

fetch
[ "$cmd" = fetch ] && exit 0
. "$entry_env"
role="$(cat "$secrets/paperless_role" 2>/dev/null || echo test)"

# Paperless must be up and empty: an import over existing documents mixes two archives.
i=0
until case "$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 http://127.0.0.1:8000/api/ || true)" in 200|302|401|403) true ;; *) false ;; esac; do
  i=$((i + 1)); [ "$i" -le 120 ] || fail "Paperless did not come up"; sleep 5
done
count="$(paperless-manage shell -c 'from documents.models import Document; print("count", Document.global_objects.count() if hasattr(Document, "global_objects") else Document.objects.count())' 2>>"$log" | sed -n 's/^count //p' | tail -1)"
[ "$count" = 0 ] || fail "Paperless is not empty (${count:-unknown} documents); refusing to import over it"

paperless-manage document_importer ../export/restore/import --no-progress-bar >>"$log" 2>&1 || fail "document_importer failed (see $log)"
t4=$(date +%s)

mail="kept"
if [ "$role" != primary ]; then
  paperless-manage shell -c 'from paperless_mail.models import MailRule; print("disabled", MailRule.objects.update(enabled=False))' >>"$log" 2>&1 \
    || fail "could not switch off the imported mail rules"
  mail="off"
fi
# The login the app shows: an imported "admin" brings the other instance's
# password (the Mac's, after a move), which the app does not know. Set it to
# the one this vault derives; the stack has it as PAPERLESS_ADMIN_PASSWORD, so
# it never appears on a command line. Other users keep theirs.
admin="$(paperless-manage shell -c 'import os
from django.contrib.auth.models import User
name = os.environ.get("PAPERLESS_ADMIN_USER") or "admin"
password = os.environ.get("PAPERLESS_ADMIN_PASSWORD")
if not password:
    print("admin skipped")
else:
    user = User.objects.filter(username=name).first()
    if user is None:
        User.objects.create_superuser(name, "", password)
        print("admin created")
    else:
        user.set_password(password)
        user.is_active = True
        user.save()
        print("admin set")' 2>>"$log" | sed -n 's/^admin //p' | tail -1)"

counts="$(paperless-manage shell -c 'from documents.models import Document; a = Document.objects.count(); g = Document.global_objects.count() if hasattr(Document, "global_objects") else a; print("counts", a, g - a)' 2>>"$log" | sed -n 's/^counts //p' | tail -1)"
documents="${counts%% *}"; trash="${counts##* }"

# What was restored needs no new backup: the first check compares against it.
paperless-backup fingerprint > /var/lib/paperless-anywhere/backed-up.fingerprint 2>>"$log" || true

status done ",\"backup\":\"$name\",\"provider\":\"$got\",\"documents\":${documents:-0},\"trash\":${trash:-0},\"mail_rules\":\"$mail\",\"admin\":\"${admin:-unknown}\",\"role\":\"$role\",\"seconds\":{\"download\":$((t2 - t1)),\"decrypt\":$((t3 - t2)),\"import\":$((t4 - t3)),\"total\":$((t4 - t0))}"
echo "paperless-restore: $name restored, ${documents:-?} documents, mail rules $mail, admin ${admin:-unknown}"
