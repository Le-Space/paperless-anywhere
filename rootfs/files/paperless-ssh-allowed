#!/bin/sh
# paperless-ssh-allowed: decides whether sshd may start (ExecStartPre of
# ssh.service, see ssh.service.d/paperless-anywhere.conf).
#
# The image carries no SSH key, so nobody can log in to a VM the app started,
# and then sshd has no business listening on the VM's public address. It
# starts only when a public key came with the unlock (a test's, which the
# confidential init has put into root's authorized_keys by now).
#
# On a productive instance (role "primary") a key alone is not enough: the
# unlock must also say so in a secret of its own, paperless_debug_ssh=yes.
# The app never sends that; the one caller is the live test that backs up to
# mainnet, which needs the productive role and drives its VM over SSH.
# (The two paths can be moved for the tests in pwa/src/lib/rootfs-vm.spec.js;
# under systemd they are these.)
keys="${PAPERLESS_SSH_KEYS:-/root/.ssh/authorized_keys}"
secrets="${PAPERLESS_SECRETS:-/tmp/secrets}"
role="$(cat "$secrets/paperless_role" 2>/dev/null || echo test)"
if [ "$role" = primary ] && [ "$(cat "$secrets/paperless_debug_ssh" 2>/dev/null)" != yes ]; then
  echo "paperless-ssh-allowed: a productive instance runs no sshd" >&2
  exit 1
fi
if grep -Eq '^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp(256|384|521)|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com) ' "$keys" 2>/dev/null; then
  exit 0
fi
echo "paperless-ssh-allowed: no key came with the unlock, sshd stays off" >&2
exit 1
