#!/bin/sh
# The stack's secrets, before it starts. Taken from /tmp/secrets when they
# came with the unlock (relay-button injects them over the attested channel
# with the LUKS passphrase); otherwise made once on this encrypted disk.
set -eu
dir=/etc/paperless-anywhere
# The data directories are entered by the containers' own users (postgres
# runs initdb as postgres), so they are made before the umask for secrets.
install -d -m 755 /srv/paperless /srv/paperless/pg /srv/paperless/valkey /srv/paperless/data \
  /srv/paperless/media /srv/paperless/consume /srv/paperless/export
umask 077
mkdir -p "$dir"

secret() {
  if [ -s "/tmp/secrets/$1" ]; then
    cat "/tmp/secrets/$1"
  else
    [ -s "$dir/$1" ] || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$dir/$1"
    cat "$dir/$1"
  fi
}

db="$(secret paperless_db_password)"
printf 'POSTGRES_PASSWORD=%s\n' "$db" > "$dir/postgres.env"
{
  printf 'PAPERLESS_DBPASS=%s\n' "$db"
  printf 'PAPERLESS_SECRET_KEY=%s\n' "$(secret paperless_secret_key)"
  printf 'PAPERLESS_ADMIN_USER=admin\n'
  printf 'PAPERLESS_ADMIN_PASSWORD=%s\n' "$(secret paperless_admin_password)"
  if [ -s "$dir/hostname" ]; then printf 'PAPERLESS_URL=https://%s\n' "$(cat "$dir/hostname")"; fi
} > "$dir/paperless.env"

# Under the confidential systemctl replacement, After=docker.service does not
# wait for the daemon to answer.
i=0
until docker info >/dev/null 2>&1; do
  i=$((i + 1))
  [ "$i" -le 90 ] || { echo "paperless-secrets: dockerd did not answer" >&2; exit 1; }
  sleep 2
done
