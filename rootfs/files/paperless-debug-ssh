#!/bin/sh
# paperless-debug-ssh: SSH for diagnosis, only when asked for at the unlock.
# The app never sends it. A test that starts a VM may add a public key as the
# secret debug_authorized_keys, which, like every secret, comes over the
# attested channel signed by the key that started this VM. Without it, root
# has no authorized key and SSH stays closed. The status page says when it is
# on (debugSsh), so it cannot be on unnoticed.
set -u
src=/tmp/secrets/debug_authorized_keys
flag=/run/paperless-anywhere/debug-ssh
mkdir -p /run/paperless-anywhere
[ -s "$src" ] || exit 0
keys="$(grep -E '^(ssh-ed25519|ecdsa-sha2-nistp256|ssh-rsa) [A-Za-z0-9+/=]+( [^[:cntrl:]]*)?$' "$src" | head -5)"
[ -n "$keys" ] || { echo "paperless-debug-ssh: no valid public key in $src" >&2; exit 0; }
install -d -m 700 /root/.ssh
printf '%s\n' "$keys" > /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
: > "$flag"
