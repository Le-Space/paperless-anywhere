#!/bin/sh
# paperless-status: every five seconds, what the app that started this VM may
# know: whether Paperless answers, and the outcome of the restore, the
# backups and a stop request. No secrets, no document names. The public page,
# /run/paperless-anywhere/public/status.json (Caddy serves it at
# /anywhere/status.json), says only the phase; the details are at a path
# derived from the status_token secret, and without that token nowhere.
set -u
dir=/run/paperless-anywhere
pub="$dir/public"
mkdir -p "$pub"
chmod 755 "$pub"
# When this script first ran: the disk is open and the services are starting.
[ -s "$dir/timeline.json" ] || printf '{"unlocked":%s}\n' "$(date +%s)" > "$dir/timeline.json"
# Caddy serves this page from the first moments, before the sealed data area
# is known and also when it failed: with a fixed address over the instance's
# 2n6 name until the fixed name has its certificate (paperless-https).
host="$(head -c 253 /tmp/secrets/https_hostname 2>/dev/null | tr -d '\r\n')"
[ -z "$host" ] || /usr/local/sbin/paperless-https --status "$host" \
  || echo "paperless-status: Caddy could not be set up for the status page" >&2
compose="docker compose --project-directory /opt/paperless"
while :; do
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:8000/api/ || true)"
  case "$code" in 200|302|401|403) up=true ;; *) up=false ;; esac
  # How far the start is: dockerd, the images (pulled after the unlock, the
  # slow part on vfs), the containers, Caddy's certificate.
  docker=false; images=0; total=0; running=0
  if docker info >/dev/null 2>&1; then
    docker=true
    for image in $($compose config --images 2>/dev/null); do
      total=$((total + 1))
      docker image inspect "$image" >/dev/null 2>&1 && images=$((images + 1))
    done
    running="$($compose ps --status running -q 2>/dev/null | wc -l | tr -d ' ')"
  fi
  # The certificate of the name Paperless is served on: with a fixed address
  # that one (a 2n6 name's for the status page does not count).
  cert=false
  if [ -e "$dir/fixed-address.wanted" ]; then
    [ -s /var/lib/caddy/fixed/cert.pem ] && cert=true
  else
    [ -n "$(find /run/caddy /var/lib/caddy /root/.local/share/caddy -name '*.crt' 2>/dev/null | head -1)" ] && cert=true
  fi
  python3 - "$dir" "$up" "$docker" "$images" "$total" "$running" "$cert" > "$pub/status.json.tmp" <<'PY' && mv "$pub/status.json.tmp" "$pub/status.json"
import json, os, re, sys, time
d, up = sys.argv[1], sys.argv[2] == "true"
docker, images, total, running, cert = sys.argv[3] == "true", int(sys.argv[4]), int(sys.argv[5]), int(sys.argv[6]), sys.argv[7] == "true"
now = int(time.time())
# First time each step was seen, kept across loops: the app shows the start
# step by step once the page is reachable, which is only after the certificate.
try:
    timeline = json.load(open(os.path.join(d, "timeline.json")))
except Exception:
    timeline = {}
for step, done in (("docker", docker), ("images", total > 0 and images == total), ("containers", total > 0 and running >= total), ("cert", cert), ("paperless", up)):
    if done and step not in timeline:
        timeline[step] = now
json.dump(timeline, open(os.path.join(d, "timeline.json.tmp"), "w"))
os.replace(os.path.join(d, "timeline.json.tmp"), os.path.join(d, "timeline.json"))
def read(name):
    try:
        return json.load(open(os.path.join(d, name)))
    except Exception:
        return None
restore, backup, stop, data_disk, fixed = read("restore.json"), read("backup.json"), read("stop.json"), read("data-disk.json"), read("fixed-address.json")
net = read("net-hardening.json")
# What this image can do (build-image.sh installs it read-only).
try:
    capabilities = json.load(open("/usr/share/paperless-anywhere/capabilities.json"))
except Exception:
    capabilities = None
# The backup tool's last retention plan (paperless-backup): which backups stay
# and why, which it scheduled for removal. Piece CIDs, dates, sizes; private page only.
retention = read("retention.json")
schedule, request = read("backup-schedule.json"), read("backup-request.json")
# The last backup that ran (done, partial or failed): backup.json says "unchanged"
# after every check that found nothing new, so the last real outcome is kept
# aside, on the VM's disk (paperless-backup-loop's directory).
last_path = "/var/lib/paperless-anywhere/last-backup.json"
try:
    last = json.load(open(last_path))
except Exception:
    last = None
if backup and backup.get("status") in ("done", "partial", "failed") and backup != last:
    try:
        os.makedirs(os.path.dirname(last_path), exist_ok=True)
        json.dump(backup, open(last_path + ".tmp", "w"))
        os.replace(last_path + ".tmp", last_path)
    except OSError:
        pass
    last = backup
# Every backup this VM made with the vault's mark (paperless-backup): piece
# CID and the vault's MAC over it, for the app to check. Only on the private page.
try:
    marks = json.load(open("/var/lib/paperless-anywhere/backup-marks.json"))
    marks = [{"pieceCid": str(m["pieceCid"]), "mark": str(m["mark"])} for m in marks if isinstance(m, dict) and "pieceCid" in m and "mark" in m][-200:]
except Exception:
    marks = []
def usage(path):
    try:
        st = os.statvfs(path)
        return {"usedBytes": (st.f_blocks - st.f_bfree) * st.f_frsize, "sizeBytes": st.f_blocks * st.f_frsize}
    except Exception:
        return None
disks = {"system": usage("/"), "data": usage("/srv/sealed") if os.path.ismount("/srv/sealed") else None}
# Memory, so a backup that runs out of it shows while it runs: totals from
# /proc/meminfo and the kernel's count of processes it killed for lack of it.
# The documents' size (originals, archive copies, thumbnails) and the
# database's, measured at most every ten minutes: walking the files every five
# seconds would cost more than it tells. The app shows the documents against
# what the package includes.
def storage():
    cache = os.path.join(d, "storage.json")
    try:
        c = json.load(open(cache))
        if now - int(c.get("at", 0)) < 600:
            return c
    except Exception:
        pass
    def size(path):
        total = 0
        for root, _dirs, files in os.walk(path):
            for f in files:
                try:
                    st = os.lstat(os.path.join(root, f))
                except OSError:
                    continue
                if not os.path.islink(os.path.join(root, f)):
                    total += st.st_size
        return total
    if not os.path.isdir("/srv/paperless/media"):
        return None
    c = {"documentsBytes": size("/srv/paperless/media"), "databaseBytes": size("/srv/paperless/pg"), "at": now}
    try:
        json.dump(c, open(cache + ".tmp", "w"))
        os.replace(cache + ".tmp", cache)
    except OSError:
        pass
    return c
def memory():
    try:
        m = {l.split(":")[0]: int(l.split()[1]) * 1024 for l in open("/proc/meminfo") if l.split()[1:2] and l.split()[1].isdigit()}
        v = dict(l.split() for l in open("/proc/vmstat") if len(l.split()) == 2)
        return {"totalBytes": m.get("MemTotal"), "availableBytes": m.get("MemAvailable"), "swapBytes": m.get("SwapTotal"), "oomKills": int(v.get("oom_kill", 0))}
    except Exception:
        return None
if stop and stop.get("status") in ("running", "ready", "failed", "partial"):
    phase = {"running": "stopping", "ready": "stopped", "partial": "stop-partial"}.get(stop["status"], "stop-failed")
elif data_disk and data_disk.get("status") != "encrypted":
    phase = "data-disk-failed"
elif fixed and fixed.get("status") == "failed" and fixed.get("final"):
    # The fixed name will not answer (paperless-fixed-address gave up): said
    # here, over the 2n6 name, instead of a port that stays closed.
    phase = "address-failed"
elif restore and restore.get("status") == "running":
    phase = "restoring"
elif restore and restore.get("status") == "failed":
    phase = "restore-failed"
elif up:
    phase = "ready"
else:
    phase = "starting"
# The end of the paid period the app handed over (paperless-period-end), Unix
# seconds or null; and why a stop ran: "app" (Sichern und beenden) or
# "period-end" (the VM's own stop before the end). The public page names the
# reason too, never the backup: the app erases a VM stopped at the period's
# end at its next opening, and Le Space Credits may read it as a hint.
def period_end():
    try:
        v = re.sub(r"[^0-9]", "", open("/tmp/secrets/period_end").read(32))
        return int(v) if v and int(v) > 0 else None
    except (OSError, ValueError):
        return None
# Which step the start waits for, while it is not ready: the sealed data area,
# the fixed address's DNS records or certificate, the restore's download
# (fetch, check, decrypt) or its import, the images, the containers, or
# Paperless itself. No secrets, no names; on the public page too.
def waiting():
    if phase not in ("starting", "restoring"):
        return None
    if not data_disk:
        return "data-area"
    f = (fixed or {}).get("status")
    if f == "dns":
        return "dns"
    if f == "restore":
        return "restore-download"
    if f == "certificate":
        return "certificate"
    if restore and restore.get("status") == "running":
        return "restore-import" if restore.get("stage") == "import" else "restore-download"
    if os.path.exists(os.path.join(d, "fixed-address.wanted")) and f != "ready":
        return "certificate"
    if not docker or total == 0 or images < total:
        return "images"
    if running < total:
        return "containers"
    return "paperless"
wait = waiting()
stop_reason = (stop.get("reason") if stop.get("reason") in ("app", "period-end") else "app") if stop and phase in ("stopping", "stopped", "stop-partial", "stop-failed") else None
public = {"v": 2, "phase": phase, "paperless": up, **({"stopReason": stop_reason} if stop_reason else {}), **({"waiting": wait} if wait else {}), "at": now}
full = {"v": 2, "phase": phase, "waiting": wait, "stopReason": stop_reason, "periodEnd": period_end(), "paperless": up, "start": {"images": images, "imagesTotal": total, "containers": running, "timeline": timeline}, "restore": restore, "backup": backup, "lastBackup": last, "backupSchedule": schedule, "backupRequest": request, "backupMarks": marks, "retention": retention, "stop": stop, "dataDisk": data_disk, "fixedAddress": fixed, "netHardening": net, "disks": disks, "memory": memory(), "storage": storage(), "capabilities": capabilities, "at": now}
# The details only at a path the app that started this VM derives from its
# vault (the status_token secret); the public page says no more than the phase.
token = ""
try:
    token = open("/tmp/secrets/status_token").read().strip()
except OSError:
    pass
if re.fullmatch(r"[0-9a-f]{32}", token):
    sdir = os.path.join(d, "public", "s")
    os.makedirs(sdir, exist_ok=True)
    os.chmod(sdir, 0o755)
    for old in os.listdir(sdir):
        if old != token + ".json":
            os.remove(os.path.join(sdir, old))
    tmp = os.path.join(sdir, token + ".json.tmp")
    with open(tmp, "w") as f:
        json.dump(full, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(sdir, token + ".json"))
    print(json.dumps(public))
else:
    # Without a token there is no private page, and the public one still says
    # no more than the phase: the details stay on the VM.
    print(json.dumps(public))
PY
  chmod 644 "$pub/status.json" 2>/dev/null
  sleep 5
done
