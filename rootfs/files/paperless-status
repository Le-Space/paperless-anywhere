#!/bin/sh
# paperless-status: every five seconds, what the app that started this VM may
# know, in /run/paperless-anywhere/public/status.json (Caddy serves it at
# /anywhere/status.json): whether Paperless answers, and the outcome of the
# restore, the backups and a stop request. No secrets, no document names.
set -u
dir=/run/paperless-anywhere
pub="$dir/public"
mkdir -p "$pub"
chmod 755 "$pub"
# When this script first ran: the disk is open and the services are starting.
[ -s "$dir/timeline.json" ] || printf '{"unlocked":%s}\n' "$(date +%s)" > "$dir/timeline.json"
compose="docker compose --project-directory /opt/paperless"
while :; do
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:8000/api/ || true)"
  case "$code" in 200|302|401|403) up=true ;; *) up=false ;; esac
  # How far the start is: dockerd, the images (pulled after the unlock, the
  # slow part on vfs), the containers, Caddy's certificate.
  docker=false; images=0; total=0; running=0
  if docker info >/dev/null 2>&1; then
    docker=true
    for image in $($compose config --images 2>/dev/null); do
      total=$((total + 1))
      docker image inspect "$image" >/dev/null 2>&1 && images=$((images + 1))
    done
    running="$($compose ps --status running -q 2>/dev/null | wc -l | tr -d ' ')"
  fi
  cert=false
  [ -n "$(find /var/lib/caddy /root/.local/share/caddy -name '*.crt' 2>/dev/null | head -1)" ] && cert=true
  python3 - "$dir" "$up" "$docker" "$images" "$total" "$running" "$cert" > "$pub/status.json.tmp" <<'PY' && mv "$pub/status.json.tmp" "$pub/status.json"
import json, os, re, sys, time
d, up = sys.argv[1], sys.argv[2] == "true"
docker, images, total, running, cert = sys.argv[3] == "true", int(sys.argv[4]), int(sys.argv[5]), int(sys.argv[6]), sys.argv[7] == "true"
now = int(time.time())
# First time each step was seen, kept across loops: the app shows the start
# step by step once the page is reachable, which is only after the certificate.
try:
    timeline = json.load(open(os.path.join(d, "timeline.json")))
except Exception:
    timeline = {}
for step, done in (("docker", docker), ("images", total > 0 and images == total), ("containers", total > 0 and running >= total), ("cert", cert), ("paperless", up)):
    if done and step not in timeline:
        timeline[step] = now
json.dump(timeline, open(os.path.join(d, "timeline.json.tmp"), "w"))
os.replace(os.path.join(d, "timeline.json.tmp"), os.path.join(d, "timeline.json"))
def read(name):
    try:
        return json.load(open(os.path.join(d, name)))
    except Exception:
        return None
restore, backup, stop, data_disk, fixed = read("restore.json"), read("backup.json"), read("stop.json"), read("data-disk.json"), read("fixed-address.json")
net = read("net-hardening.json")
schedule, request = read("backup-schedule.json"), read("backup-request.json")
# The last backup that ran (done, partial or failed): backup.json says "unchanged"
# after every check that found nothing new, so the last real outcome is kept
# aside, on the VM's disk (paperless-backup-loop's directory).
last_path = "/var/lib/paperless-anywhere/last-backup.json"
try:
    last = json.load(open(last_path))
except Exception:
    last = None
if backup and backup.get("status") in ("done", "partial", "failed") and backup != last:
    try:
        os.makedirs(os.path.dirname(last_path), exist_ok=True)
        json.dump(backup, open(last_path + ".tmp", "w"))
        os.replace(last_path + ".tmp", last_path)
    except OSError:
        pass
    last = backup
def usage(path):
    try:
        st = os.statvfs(path)
        return {"usedBytes": (st.f_blocks - st.f_bfree) * st.f_frsize, "sizeBytes": st.f_blocks * st.f_frsize}
    except Exception:
        return None
disks = {"system": usage("/"), "data": usage("/srv/sealed") if os.path.ismount("/srv/sealed") else None}
# Memory, so a backup that runs out of it shows while it runs: totals from
# /proc/meminfo and the kernel's count of processes it killed for lack of it.
# The documents' size (originals, archive copies, thumbnails) and the
# database's, measured at most every ten minutes: walking the files every five
# seconds would cost more than it tells. The app shows the documents against
# what the package includes.
def storage():
    cache = os.path.join(d, "storage.json")
    try:
        c = json.load(open(cache))
        if now - int(c.get("at", 0)) < 600:
            return c
    except Exception:
        pass
    def size(path):
        total = 0
        for root, _dirs, files in os.walk(path):
            for f in files:
                try:
                    st = os.lstat(os.path.join(root, f))
                except OSError:
                    continue
                if not os.path.islink(os.path.join(root, f)):
                    total += st.st_size
        return total
    if not os.path.isdir("/srv/paperless/media"):
        return None
    c = {"documentsBytes": size("/srv/paperless/media"), "databaseBytes": size("/srv/paperless/pg"), "at": now}
    try:
        json.dump(c, open(cache + ".tmp", "w"))
        os.replace(cache + ".tmp", cache)
    except OSError:
        pass
    return c
def memory():
    try:
        m = {l.split(":")[0]: int(l.split()[1]) * 1024 for l in open("/proc/meminfo") if l.split()[1:2] and l.split()[1].isdigit()}
        v = dict(l.split() for l in open("/proc/vmstat") if len(l.split()) == 2)
        return {"totalBytes": m.get("MemTotal"), "availableBytes": m.get("MemAvailable"), "swapBytes": m.get("SwapTotal"), "oomKills": int(v.get("oom_kill", 0))}
    except Exception:
        return None
if stop and stop.get("status") in ("running", "ready", "failed", "partial"):
    phase = {"running": "stopping", "ready": "stopped", "partial": "stop-partial"}.get(stop["status"], "stop-failed")
elif data_disk and data_disk.get("status") != "encrypted":
    phase = "data-disk-failed"
elif restore and restore.get("status") == "running":
    phase = "restoring"
elif restore and restore.get("status") == "failed":
    phase = "restore-failed"
elif up:
    phase = "ready"
else:
    phase = "starting"
full = {"v": 2, "phase": phase, "paperless": up, "start": {"images": images, "imagesTotal": total, "containers": running, "timeline": timeline}, "restore": restore, "backup": backup, "lastBackup": last, "backupSchedule": schedule, "backupRequest": request, "stop": stop, "dataDisk": data_disk, "fixedAddress": fixed, "netHardening": net, "disks": disks, "memory": memory(), "storage": storage(), "at": now}
# The details only at a path the app that started this VM derives from its
# vault (the status_token secret); the public page says no more than the phase.
token = ""
try:
    token = open("/tmp/secrets/status_token").read().strip()
except OSError:
    pass
if re.fullmatch(r"[0-9a-f]{32}", token):
    sdir = os.path.join(d, "public", "s")
    os.makedirs(sdir, exist_ok=True)
    os.chmod(sdir, 0o755)
    for old in os.listdir(sdir):
        if old != token + ".json":
            os.remove(os.path.join(sdir, old))
    tmp = os.path.join(sdir, token + ".json.tmp")
    with open(tmp, "w") as f:
        json.dump(full, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(sdir, token + ".json"))
    print(json.dumps({"v": 2, "phase": phase, "paperless": up, "at": now}))
else:
    # Without a token (an app from before the private page): the backup
    # details of this image stay off the public page.
    print(json.dumps({k: v for k, v in full.items() if k not in ("lastBackup", "backupSchedule", "backupRequest", "storage")}))
PY
  chmod 644 "$pub/status.json" 2>/dev/null
  sleep 5
done
