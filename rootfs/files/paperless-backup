#!/bin/sh
# paperless-backup [check|run|fingerprint]: back up this Paperless with
# paperless-backup-filecoin, signed by a session key, never by the wallet:
# the wallet's session key, or Le Space's, which Le Space Credits use for the
# VM after their checks (remoteSigner).
#
#   check        back up if Paperless changed since the last backup or the restore
#                (paperless-backup-loop runs this every two hours; stop runs it last)
#   run          back up now
#   fingerprint  print what "changed" compares (documents, trash, last change, labels)
#
# Comes with the unlock, over the attested channel:
#   /tmp/secrets/backup_config       paperless-backup-filecoin config.json: network,
#                                    providers, ageRecipient (public), datasetMetadata,
#                                    payer (the wallet the session key acts for, or
#                                    Le Space's payer), and with Le Space Credits
#                                    remoteSigner: { creditsUrl, product, account,
#                                    payer, signer, tag, label }
#   /tmp/secrets/backup_session_key  wallet path: a session key the wallet authorized
#                                    for creating data sets and adding pieces only,
#                                    until it expires (SESSION_KEY_FILE)
#   /tmp/secrets/backup_key          Le Space Credits: this VM's backup key, derived
#                                    from the vault; it holds nothing and only asks
#                                    the service to sign each step (BACKUP_KEY_FILE)
#   /tmp/secrets/paperless_role      "primary" backs up to mainnet; anything else is a
#                                    test and must use the calibration network
#
# No age identity is needed: backups are encrypted to ageRecipient. The session key
# cannot delete pieces, so pruning stays with the wallet. Outcome:
# /run/paperless-anywhere/backup.json; the tool's log stays on the encrypted disk.
# Exit 0: backed up (or unchanged); 2: "partial", fewer copies than requested;
# anything else: failed.
set -u
secrets=/tmp/secrets
state_dir=/run/paperless-anywhere
state="$state_dir/backup.json"
lib=/var/lib/paperless-anywhere
log_dir=/var/log/paperless-anywhere
mkdir -p "$state_dir" "$lib" "$log_dir"
chmod 700 "$lib" "$log_dir"
cmd="${1:-check}"
# One backup at a time: the two-hourly check and the stop's last backup.
if [ "$cmd" != fingerprint ]; then
  exec 8>"$state_dir/backup.lock"
  flock 8
fi

status() {
  printf '{"status":"%s","at":"%s"%s}\n' "$1" "$(date -u +%FT%TZ)" "${2:-}" > "$state.tmp" && mv "$state.tmp" "$state"
}
# The tool's own log lines, made fit for the public status page: its
# timestamped lines and its last "error:" line, with paths and quoted names
# blanked; of an exception (Python's, the exporter's) only its class and errno,
# never its message, which may quote a document. Not Python's warnings, which
# name files. A JSON array of the last N.
loglines() {
  python3 - "$log_dir/backup.log" "${1:-12}" <<'LOG'
import json, re, sys
try:
    lines = open(sys.argv[1], errors="replace").read().splitlines()
except OSError:
    lines = []
def clean(l):
    l = re.sub(r"'[^']*'|\"[^\"]*\"", "'…'", l)
    # Paths go, a provider's https:// address stays: it says who refused.
    l = re.sub(r"(?<![\w:/])/[^\s]+", "/…", l)
    l = re.sub(r"(?:0x)?[0-9a-fA-F]{64}", "…", l)
    # Long enough for the provider's answer after "provider says:".
    return l[:400]
keep = []
for l in lines:
    if re.match(r"^\d{4}-\d{2}-\d{2}T[\d:.]+Z ", l) or l.startswith("error: "):
        keep.append(clean(l))
        continue
    m = re.match(r"^((?:[A-Za-z_]\w*\.)*[A-Za-z_]\w*(?:Error|Exception|Interrupt|Exit))\b:?\s*(\[Errno \d+\] [A-Za-z ]+)?", l)
    if m:
        keep.append(("exception: " + m.group(1) + (" " + m.group(2).strip() if m.group(2) else ""))[:220])
print(json.dumps(keep[-int(sys.argv[2]):]))
LOG
}
# What the machine had when a backup failed: free memory and swap, free space
# under /srv, and how often the kernel killed a process for lack of memory
# since the backup began. Numbers only.
oom_kills() { awk '$1 == "oom_kill" { print $2; f = 1 } END { if (!f) print 0 }' /proc/vmstat 2>/dev/null || echo 0; }
machine() {
  printf ',"exit":%s,"oomKills":%s,"memAvailableBytes":%s,"swapBytes":%s,"srvFreeBytes":%s' \
    "${rc:-null}" "$(( $(oom_kills) - ${oom0:-0} ))" \
    "$(awk '$1 == "MemAvailable:" { print $2 * 1024 }' /proc/meminfo)" \
    "$(awk '$1 == "SwapTotal:" { print $2 * 1024 }' /proc/meminfo)" \
    "$(df -B1 --output=avail /srv/paperless 2>/dev/null | tail -1 | tr -d ' ' | grep -E '^[0-9]+$' || echo null)"
}
fail() {
  echo "paperless-backup: $*" >&2
  status failed ",\"reason\":\"$(printf '%s' "$*" | tr -d '"\\\n' | cut -c1-200)\",\"log\":$(loglines 12)$(machine)"
  exit 1
}

fingerprint() {
  paperless-manage shell -c '
from documents.models import Document, Tag, Correspondent, DocumentType, Note
from django.db.models import Max
import json
d = Document.global_objects
print("FP" + json.dumps({
  "documents": d.filter(deleted_at__isnull=True).count(),
  "trash": d.filter(deleted_at__isnull=False).count(),
  "modified": str(d.aggregate(m=Max("modified"))["m"]),
  "notes": Note.objects.count(),
  "labels": [m.objects.count() for m in (Tag, Correspondent, DocumentType)],
  "labelIds": [m.objects.aggregate(m=Max("id"))["m"] for m in (Tag, Correspondent, DocumentType)],
}, sort_keys=True))' 2>/dev/null | sed -n 's/^FP//p' | tail -1
}

if [ "$cmd" = fingerprint ]; then fingerprint; exit 0; fi
case "$cmd" in check|run) ;; *) echo "usage: paperless-backup [check|run|fingerprint]" >&2; exit 2 ;; esac

if [ ! -s "$secrets/backup_config" ]; then
  status skipped ',"reason":"no backup_config came with the unlock"'
  exit 0
fi
# Le Space Credits sign for the VM (remoteSigner) with its backup key; the
# wallet path signs with the wallet's session key.
if python3 -c 'import json, sys; sys.exit(0 if isinstance(json.load(open(sys.argv[1])).get("remoteSigner"), dict) else 1)' "$secrets/backup_config" 2>/dev/null; then
  signing=remote
  [ -s "$secrets/backup_key" ] || fail "a backup_config with remoteSigner came without a backup_key"
else
  signing=session
  [ -s "$secrets/backup_session_key" ] || fail "a backup_config came without a backup_session_key"
fi
role="$(cat "$secrets/paperless_role" 2>/dev/null || echo test)"

# The config as the tool reads it; the network must fit the role, and the
# machine never prunes (a session key may not remove pieces anyway).
config="$state_dir/backup-config.json"
python3 - "$secrets/backup_config" "$config" "$role" <<'PY' || fail "unusable backup_config"
import json, re, sys
c = json.load(open(sys.argv[1]))
role = sys.argv[3]
want = "mainnet" if role == "primary" else "calibration"
if c.get("network") != want:
    sys.exit(f"role {role} needs network {want}, the config says {c.get('network')}")
if not re.fullmatch(r"0x[0-9a-fA-F]{40}", str(c.get("payer", ""))):
    sys.exit("backup_config has no payer address")
if not str(c.get("ageRecipient", "")).startswith("age1"):
    sys.exit("backup_config has no ageRecipient")
r = c.get("remoteSigner")
if r is not None:
    addr = lambda v: re.fullmatch(r"0x[0-9a-fA-F]{40}", str(v or "")) is not None
    if not isinstance(r, dict) or not all(addr(r.get(k)) for k in ("account", "payer", "signer")):
        sys.exit("remoteSigner needs account, payer and signer addresses")
    if not str(r.get("creditsUrl", "")).startswith("https://"):
        sys.exit("remoteSigner needs an https creditsUrl")
    if not (r.get("product") and r.get("tag") and r.get("label")):
        sys.exit("remoteSigner needs product, tag and label")
    if r["payer"].lower() != str(c.get("payer", "")).lower():
        sys.exit("remoteSigner names another payer than the config")
c.pop("mail", None)
c["daily"] = {**c.get("daily", {}), "prune": False}
json.dump(c, open(sys.argv[2], "w"))
PY
chmod 600 "$config"

now="$(fingerprint)"
[ -n "$now" ] || fail "could not read Paperless's state"
if [ "$cmd" = check ] && [ -s "$lib/backed-up.fingerprint" ] && [ "$now" = "$(cat "$lib/backed-up.fingerprint")" ]; then
  status unchanged ",\"role\":\"$role\""
  exit 0
fi

status running ",\"role\":\"$role\""
t0=$(date +%s)
oom0="$(oom_kills)"
# What a run that failed left behind (its export folder, its zip, its sealed
# file) goes first: it holds every document in the clear and takes the room
# the next export needs. The restore's folder (export/restore) stays.
find /srv/paperless/export -mindepth 1 -maxdepth 1 -name 'paperless-*' -exec rm -rf {} + 2>/dev/null
cd /opt/backup-filecoin || fail "no backup tool in /opt/backup-filecoin"
export BACKUP_CONFIG="$config" PAPERLESS_DIR=/srv/paperless PAPERLESS_MANAGE=/usr/local/sbin/paperless-manage
# The key's file, never the key: it stays in /tmp/secrets and out of the log.
if [ "$signing" = remote ]; then
  export BACKUP_KEY_FILE="$secrets/backup_key"
else
  export SESSION_KEY_FILE="$secrets/backup_session_key"
fi
# The fixed address's certificate and lego account go along (sealed with the
# backup), so a restore brings them back instead of asking the CA again.
[ -d /etc/paperless-anywhere/tls ] && export EXPORT_EXTRA_DIR=/etc/paperless-anywhere/tls
# While it runs, its latest lines go to the status page (the app shows them).
: > "$log_dir/backup.log.run"
node backup.mjs run > "$log_dir/backup.log.run" 2>&1 &
pid=$!
while kill -0 "$pid" 2>/dev/null; do
  cat "$log_dir/backup.log.run" >> "$log_dir/backup.log" && : > "$log_dir/backup.log.run"
  status running ",\"role\":\"$role\",\"log\":$(loglines 3)"
  sleep 5
done
wait "$pid"; rc=$?
cat "$log_dir/backup.log.run" >> "$log_dir/backup.log"; rm -f "$log_dir/backup.log.run"
if [ "$rc" -ne 0 ]; then
  if [ "$(( $(oom_kills) - oom0 ))" -gt 0 ]; then fail "the backup ran out of memory (exit $rc)"
  elif [ "$rc" -ge 128 ]; then fail "the backup was stopped by signal $(( rc - 128 ))"
  else fail "the backup did not complete (exit $rc)"; fi
fi
entry="$(python3 -c '
import json, sys
e = json.load(open(sys.argv[1]))[-1]
keep = ("providerId", "dataSetId", "pieceId", "retrievalUrl", "location", "isNewDataSet")
print(json.dumps({"name": e.get("name"), "date": e.get("date"), "pieceCid": e.get("pieceCid"), "size": e.get("size"),
  "complete": e.get("complete"), "requestedCopies": e.get("requestedCopies"),
  "copies": [{k: c.get(k) for k in keep} for c in e.get("copies", [])],
  "failedAttempts": len(e.get("failedAttempts", []))}))' \
  "$( [ "$role" = primary ] && echo ledger.json || echo ledger.calibration.json )")"
# Fewer copies than requested (a provider refused the piece; the tool went on
# with the others): "partial", exit 2. The fingerprint is not recorded, so the
# next check tries every provider again; a stop does not erase the VM without
# asking (paperless-stop). No copy at all is a failure.
short="$(printf '%s' "$entry" | python3 -c 'import json, sys
e = json.load(sys.stdin)
have, want = len(e.get("copies") or []), e.get("requestedCopies") or 0
print("" if e.get("complete") is True and have >= want else f"{have} of {want}")')"
if [ -n "$short" ]; then
  echo "paperless-backup: only $short copies" >&2
  case "$short" in
    "0 of "*) status failed ",\"reason\":\"only $short copies reached the providers\",\"backup\":$entry,\"log\":$(loglines 12)$(machine)"; exit 1 ;;
  esac
  status partial ",\"role\":\"$role\",\"reason\":\"only $short copies reached the providers\",\"backup\":$entry,\"seconds\":$(( $(date +%s) - t0 )),\"log\":$(loglines 12)"
  exit 2
fi
printf '%s\n' "$now" > "$lib/backed-up.fingerprint"
status done ",\"role\":\"$role\",\"backup\":$entry,\"seconds\":$(( $(date +%s) - t0 ))"
echo "paperless-backup: done, $entry"
