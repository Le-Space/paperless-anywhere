#!/bin/sh
# paperless-data-disk: everything this VM writes goes onto a disk area sealed
# with a key the VM makes itself at boot and keeps in memory only.
#
# The rootfs is one LUKS image for every VM, so its volume key is the same in
# every copy, and whoever knows the image's passphrase could read what a VM
# wrote to it on the node's disk. The data here lives one session anyway
# (restored from the backup at start, erased at stop), so a key that never
# leaves the VM is enough: nobody, not the node, not CI, not the app, has it.
#
# A file on the rootfs, opened with dm-crypt (plain, AES-XTS, 512-bit random
# key read from a pipe), formatted ext4, mounted at /srv/sealed; the paths the
# stack writes to are bind-mounted from there. Docker and the stack call it
# before they start (the first one does the work); Caddy reads its data dir
# after paperless-https restarts it, which comes later. If any step
# fails, the VM runs as before and says so in data-disk.json (status page).
set -u
state=/run/paperless-anywhere
mkdir -p "$state"
exec 9>"$state/data-disk.lock"
flock 9
[ -s "$state/data-disk.json" ] && exit 0

img=/srv/sealed.img
mnt=/srv/sealed
started=$(date +%s)
errlog="$state/data-disk.err"
: > "$errlog"
# What the guest offers for this, reported with the outcome (no secrets): the
# loop and device-mapper control nodes, the kernel's dm targets and crypto,
# how /dev is mounted, the block devices, and this process's capabilities.
probe() {
  python3 - "$errlog" <<'PY'
import json, os, subprocess, sys
def run(*cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return (r.stdout + r.stderr).strip()[:400]
    except Exception as e:
        return f"error: {e}"[:200]
def read(path, limit=600):
    try:
        return open(path).read()[:limit]
    except Exception as e:
        return f"error: {type(e).__name__}"
misc = read("/proc/misc", 2000)
crypto = read("/proc/crypto", 200000)
print(json.dumps({
    "kernel": os.uname().release,
    "loopControl": os.path.exists("/dev/loop-control"),
    "loopDevices": sorted(d for d in os.listdir("/dev") if d.startswith("loop"))[:8],
    "losetupFree": run("losetup", "-f"),
    "mapperControl": os.path.exists("/dev/mapper/control"),
    "miscHasLoop": "loop-control" in misc,
    "miscHasDeviceMapper": "device-mapper" in misc,
    "dmTargets": run("dmsetup", "targets"),
    "cryptoXts": "xts(aes)" in crypto or "name         : xts" in crypto,
    "devMount": run("findmnt", "-n", "-o", "FSTYPE,OPTIONS", "/dev"),
    "blockDevices": run("lsblk", "-d", "-n", "-o", "NAME,SIZE,TYPE,RO"),
    "capEff": next((l.split()[1] for l in read("/proc/self/status", 4000).splitlines() if l.startswith("CapEff")), None),
    "cryptsetupError": read(sys.argv[1], 400).strip(),
}))
PY
}
report() {
  printf '{"status":"%s","reason":"%s","bytes":%s,"seconds":%s,"probe":%s}\n' "$1" "$2" "${3:-0}" "$(( $(date +%s) - started ))" "$(probe 2>/dev/null || echo null)" > "$state/data-disk.json"
}
plain() {
  echo "paperless-data-disk: $1; data stays on the shared-key rootfs" >&2
  report plain "$1"
  exit 0
}

command -v cryptsetup >/dev/null 2>&1 || plain "no cryptsetup"
avail=$(df -B1 --output=avail / 2>/dev/null | tail -1 | tr -d ' ')
[ -n "$avail" ] || plain "free space unknown"
# Leave 2 GiB to the rootfs (logs, apt state); refuse below 4 GiB of data area.
size=$(( avail - 2147483648 ))
[ "$size" -ge 4294967296 ] || size=0

# A spare disk (the app asks Aleph for an empty one next to the rootfs) takes
# dm-crypt directly; the guest kernel has no loop driver for a file.
# Only a disk with nothing on it counts: no partitions and no device-mapper
# holders (the rootfs's disk carries the LUKS mapping, so it is never taken).
spare=""
for d in $(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2 == "disk" { print $1 }'); do
  [ "$(lsblk -n -o NAME "/dev/$d" 2>/dev/null | wc -l)" -eq 1 ] || continue
  [ -z "$(ls -A "/sys/block/$d/holders" 2>/dev/null)" ] || continue
  [ "$(lsblk -bdno SIZE "/dev/$d" 2>/dev/null)" -ge 4294967296 ] 2>/dev/null || continue
  [ "$(lsblk -dno RO "/dev/$d" 2>/dev/null | tr -d ' ')" = 0 ] || continue
  spare="$d"
  break
done
if [ -n "$spare" ]; then
  for m in $(lsblk -nlo MOUNTPOINT "/dev/$spare" 2>/dev/null); do umount "$m" 2>/dev/null; done
  size=$(lsblk -bdno SIZE "/dev/$spare")
  head -c 64 /dev/urandom | cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 --key-file - "/dev/$spare" sealed 2>"$errlog" \
    || plain "dm-crypt on the spare disk $spare failed"
  img=""
else
  [ "$size" -gt 0 ] || plain "no spare disk, and only $((avail / 1048576)) MiB free on the rootfs"
  rm -f "$img"
  truncate -s "$size" "$img" || plain "cannot create the area file"
  head -c 64 /dev/urandom | cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 --key-file - "$img" sealed 2>"$errlog" \
    || { rm -f "$img"; plain "no spare disk, and no loop device for a file"; }
fi
mkfs.ext4 -q -F -E lazy_itable_init=1,lazy_journal_init=1 -m 0 /dev/mapper/sealed \
  || { cryptsetup close sealed; [ -n "$img" ] && rm -f "$img"; plain "mkfs failed"; }
mkdir -p "$mnt" && mount /dev/mapper/sealed "$mnt" \
  || { cryptsetup close sealed; [ -n "$img" ] && rm -f "$img"; plain "mount failed"; }

# Move what the image brings (if anything) and bind every path over.
for path in /srv/paperless /var/lib/docker /var/lib/caddy /root/.local/share/caddy /etc/paperless-anywhere /var/lib/paperless-anywhere; do
  target="$mnt$path"
  mkdir -p "$target" "$path"
  if [ -n "$(ls -A "$path" 2>/dev/null)" ]; then cp -a "$path/." "$target/" || plain "copying $path failed"; fi
  chmod --reference="$path" "$target" 2>/dev/null
  chown --reference="$path" "$target" 2>/dev/null
  mount --bind "$target" "$path" || plain "bind mount of $path failed"
done
report encrypted "${spare:-file}" "$size"
