#!/bin/sh
# paperless-stop: wait for a stop request and answer it with a last backup.
# The request comes like every secret, over the attested channel and signed by
# the key that started this VM: /tmp/secrets/stop_request (any new value is a
# new request). The outcome goes to /run/paperless-anywhere/stop.json; at
# "ready" the app may erase the VM. Without a backup configuration (a test
# without backups), the stop is ready at once.
#
# Paperless itself stops first (consumer, mail fetching, uploads), so nothing
# arrives after the export began and is lost with the VM; the export runs in
# a one-off container (paperless-manage). A backup that already runs is
# waited for first. If the backup fails, Paperless starts again and the VM
# stays.
#
# A backup with fewer copies than requested (a provider refused the piece) is
# "partial": Paperless stays paused and the app asks the person. Erasing
# anyway is the app's step; keeping the VM sends /tmp/secrets/stop_resume
# naming the stop request it answers, and Paperless starts again ("resumed");
# an old resume never restarts Paperless after a later stop. stop.json names
# the request it answers, so the app never takes an older stop's outcome for
# the one it just sent.
set -u
dir=/run/paperless-anywhere
mkdir -p "$dir"
handled=""
resumed=""
compose="docker compose --project-directory /opt/paperless"
status() {
  printf '{"status":"%s","request":"%s","at":"%s"%s}\n' "$1" "$handled" "$(date -u +%FT%TZ)" "${2:-}" > "$dir/stop.json.tmp" && mv "$dir/stop.json.tmp" "$dir/stop.json"
}
while :; do
  if [ -s /tmp/secrets/stop_request ]; then
    request="$(head -c 128 /tmp/secrets/stop_request | tr -cd '0-9A-Za-z_-')"
    if [ "$request" != "$handled" ]; then
      handled="$request"
      status running
      # A backup that runs now (the two-hourly check, or one the app asked
      # for) finishes first: pausing Paperless under it would break its
      # export. Up to 30 minutes, then the stop goes on as before. If it
      # backed up, the stop's own backup is a check: it uploads only what
      # changed since (paperless-manage runs in a one-off container, so the
      # fingerprint works with Paperless paused).
      mode=run
      if ! flock -n "$dir/backup.lock" true 2>/dev/null; then
        flock -w 1800 "$dir/backup.lock" true 2>/dev/null || echo "paperless-stop: a backup still runs after 30 minutes; stopping anyway" >&2
        grep -q '"status":"done"' "$dir/backup.json" 2>/dev/null && mode=check
      fi
      $compose stop paperless >/dev/null 2>&1 || echo "paperless-stop: could not pause Paperless before the backup" >&2
      paperless-backup "$mode"
      case $? in
        0) status ready ",\"backup\":$(cat "$dir/backup.json" 2>/dev/null || echo null)" ;;
        2) status partial ",\"backup\":$(cat "$dir/backup.json" 2>/dev/null || echo null)" ;;
        *) $compose start paperless >/dev/null 2>&1
           status failed ",\"backup\":$(cat "$dir/backup.json" 2>/dev/null || echo null)" ;;
      esac
    fi
  fi
  # The person keeps the VM after a partial backup: Paperless runs again.
  if [ -s /tmp/secrets/stop_resume ]; then
    resume="$(head -c 128 /tmp/secrets/stop_resume | tr -cd '0-9A-Za-z_-')"
    if [ -n "$resume" ] && [ "$resume" != "$resumed" ]; then
      resumed="$resume"
      if grep -q '"status":"partial"' "$dir/stop.json" 2>/dev/null && grep -q "\"request\":\"$resume\"" "$dir/stop.json"; then
        $compose start paperless >/dev/null 2>&1 || echo "paperless-stop: could not start Paperless again" >&2
        status resumed ",\"backup\":$(cat "$dir/backup.json" 2>/dev/null || echo null)"
      fi
    fi
  fi
  sleep 5
done
