#!/bin/sh
# paperless-stop: wait for a stop request and answer it with a last backup.
# The request comes like every secret, over the attested channel and signed by
# the key that started this VM: /tmp/secrets/stop_request (any new value is a
# new request). The outcome goes to /run/paperless-anywhere/stop.json; at
# "ready" the app may erase the VM. Without a backup configuration (a test
# without backups), the stop is ready at once.
#
# Paperless itself stops first (consumer, mail fetching, uploads), so nothing
# arrives after the export began and is lost with the VM; the export runs in
# a one-off container (paperless-manage). If the backup fails, Paperless
# starts again and the VM stays.
set -u
dir=/run/paperless-anywhere
mkdir -p "$dir"
handled=""
compose="docker compose --project-directory /opt/paperless"
status() {
  printf '{"status":"%s","at":"%s"%s}\n' "$1" "$(date -u +%FT%TZ)" "${2:-}" > "$dir/stop.json.tmp" && mv "$dir/stop.json.tmp" "$dir/stop.json"
}
while :; do
  if [ -s /tmp/secrets/stop_request ]; then
    request="$(head -c 128 /tmp/secrets/stop_request)"
    if [ "$request" != "$handled" ]; then
      handled="$request"
      status running
      $compose stop paperless >/dev/null 2>&1 || echo "paperless-stop: could not pause Paperless before the backup" >&2
      if paperless-backup run; then
        status ready ",\"backup\":$(cat "$dir/backup.json" 2>/dev/null || echo null)"
      else
        $compose start paperless >/dev/null 2>&1
        status failed ",\"backup\":$(cat "$dir/backup.json" 2>/dev/null || echo null)"
      fi
    fi
  fi
  sleep 5
done
