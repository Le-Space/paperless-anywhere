#!/bin/sh
# paperless-https [--early] <hostname>: serve Paperless on https://<hostname>
# through Caddy on 443 (ACME over TLS-ALPN on 443, the one port mapped for it),
# and the start status at /anywhere/status.json for the app that started it.
# --early (from paperless-secrets, before the stack starts) only writes the
# Caddyfile and restarts Caddy: PAPERLESS_URL is then right from the start.
set -eu
early=""
[ "${1:-}" = --early ] && { early=1; shift; }
host="${1:?usage: paperless-https [--early] <hostname>}"
case "$host" in *[!A-Za-z0-9.-]*|"") echo "not a hostname: $host" >&2; exit 1 ;; esac
printf '%s\n' "$host" > /etc/paperless-anywhere/hostname
# The second certificate authority's contact (ZeroSSL ties its ACME account to
# an address); from the unlock if the app sent one.
email="$(head -c 254 /tmp/secrets/acme_email 2>/dev/null | tr -d '\r\n')"
case "$email" in *@*.*) ;; *) email="paperless-anywhere@le-space.de" ;; esac
case "$email" in *[!A-Za-z0-9.@_+-]*) email="paperless-anywhere@le-space.de" ;; esac
new="$(mktemp)"
# The fixed address (paperless-fixed-address): its certificate comes over DNS,
# and Caddy also answers on the node's port, which IPv4 clients use. Until the
# certificate is there, Caddy serves nothing for it: an ACME attempt of its
# own for the name would fail (its A record is the node's) and count against
# the name at Let's Encrypt.
fixed="" port=""
if [ -s /tmp/secrets/dns_cloudflare_token ]; then
  fixed=1
  port="$(head -c 5 /tmp/secrets/https_port 2>/dev/null | tr -d '\r\n')"
  case "$port" in *[!0-9]*|"") echo "paperless-https: no port for the fixed address" >&2; exit 1 ;; esac
  printf '%s\n' "$port" > /etc/paperless-anywhere/https_port
fi
# Caddy's admin API stays off (admin off): every container shares the host
# network, so one that parses an untrusted document could otherwise reload
# Caddy with a config of its own. Changes restart Caddy instead.
serve=1
if [ -n "$fixed" ] && ! [ -s /var/lib/caddy/fixed/cert.pem ]; then
  serve=""
  printf '{\n  admin off\n  auto_https off\n}\n' > "$new"
elif [ -n "$fixed" ]; then
  also=""; [ "$port" = 443 ] || also=", https://${host}:${port}"
  cat > "$new" <<CADDY
{
  admin off
  auto_https disable_redirects
}

https://${host}${also} {
  tls /var/lib/caddy/fixed/cert.pem /var/lib/caddy/fixed/key.pem
CADDY
else
  cat > "$new" <<CADDY
{
  admin off
  auto_https disable_redirects
}

https://${host} {
  # Two certificate authorities: Let's Encrypt first, ZeroSSL when it fails.
  # Every start gets a new *.2n6.me name, and all 2n6 users share Let's
  # Encrypt's 50 certificates per week for 2n6.me (2026-10-22: a start found
  # no certificate after 35 minutes). Both over TLS-ALPN on 443, the one port
  # forwarded for it.
  tls {
    issuer acme {
      disable_http_challenge
    }
    issuer zerossl {
      email ${email}
      disable_http_challenge
    }
  }
CADDY
fi
[ -z "$serve" ] || cat >> "$new" <<CADDY
  # The start status, read by the app that started this VM from its own
  # origin: in public only the phase; the details (restore, backups, stop,
  # disks) at /anywhere/s/<token>.json, a path the app derives from its vault.
  handle /anywhere/status.json {
    header Access-Control-Allow-Origin "*"
    header Cache-Control "no-store"
    root * /run/paperless-anywhere/public
    rewrite * /status.json
    file_server
  }
  @detail path_regexp detail ^/anywhere/s/([0-9a-f]{32})\.json$
  handle @detail {
    header Access-Control-Allow-Origin "*"
    header Cache-Control "no-store"
    root * /run/paperless-anywhere/public
    rewrite * /s/{re.detail.1}.json
    file_server
  }
  reverse_proxy 127.0.0.1:8000
}
CADDY
# Restart Caddy only when its configuration changed. paperless-secrets calls
# this on every start of the stack, and a stack that keeps failing (an image
# it cannot pull) used to restart Caddy each time, which cancelled every
# certificate order: after five failed authorizations Let's Encrypt refuses
# the name for an hour, and the ZeroSSL order was cut off as well.
if ! cmp -s "$new" /etc/caddy/Caddyfile || ! systemctl is-active --quiet caddy.service; then
  install -m 644 "$new" /etc/caddy/Caddyfile
  systemctl restart caddy.service
fi
rm -f "$new"
[ -n "$early" ] && exit 0
# PAPERLESS_URL follows the hostname (Django trusts that origin for CSRF).
# A restart through the systemctl replacement does not reliably recreate the
# container with the new environment, so recreate it directly.
/usr/local/sbin/paperless-secrets
cd /opt/paperless && docker compose up -d --force-recreate --no-deps paperless
