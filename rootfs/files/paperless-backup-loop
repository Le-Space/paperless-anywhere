#!/bin/sh
# paperless-backup-loop: back up Paperless when it changed and has stayed
# quiet, at most every few hours; and a backup now when the app asks for one.
# Every CHECK seconds (ten minutes) it reads Paperless's fingerprint and asks
# paperless-backup-due whether a scheduled backup is due: changed since the
# last backup, unchanged for 30 minutes, and the last backup at least
# backup_config's schedule.minHours ago (default 6). Each backup costs fees
# per AddPieces call and piece, so a busy afternoon becomes one backup.
# A plain loop instead of a .timer: the confidential guest has no systemd, and
# its systemctl replacement ran the timer's oneshot service once and never
# again (production, 2026-11-04: one check at 09:00, none at 11:00 or later).
# First look 20 minutes after boot, as the timer did. paperless-backup takes a
# lock, so a check, a requested backup and the stop's last backup never run at
# the same time.
#
# The request comes like the stop request, over the attested channel and
# signed by the key that started this VM: /tmp/secrets/backup_request (any new
# value is a new request). It runs "paperless-backup run"; when a backup holds
# the lock at that moment, or one finished since the request came, it runs
# "check" (after it), so the same state is not uploaded twice. A stop's
# backup still stops Paperless first, so a requested backup that runs then may
# fail; the stop's own backup follows. Neither waits for the schedule, nor
# does the last backup before the paid time ends (paperless-stop). The outcome
# goes to /run/paperless-anywhere/backup-request.json, when the next look and
# the next scheduled backup are due to backup-schedule.json (paperless-backup-due
# writes it; paperless-status shows both to the app).
set -u
dir=/run/paperless-anywhere
lib=/var/lib/paperless-anywhere
mkdir -p "$dir" "$lib"
chmod 700 "$lib"
CHECK=600
FIRST=1200
schedule() {
  printf '{"nextCheck":"%s","everySeconds":%s,"pending":null,"nextBackup":null}\n' "$(date -u -d "@$next" +%FT%TZ)" "$CHECK" > "$dir/backup-schedule.json.tmp" && mv "$dir/backup-schedule.json.tmp" "$dir/backup-schedule.json"
}
due() {
  printf '%s' "$1" | CHECK_SECONDS=$CHECK /usr/local/sbin/paperless-backup-due backup
}
request_status() {
  printf '{"status":"%s","mode":"%s","at":"%s"%s}\n' "$1" "$2" "$(date -u +%FT%TZ)" "${3:-}" > "$dir/backup-request.json.tmp" && mv "$dir/backup-request.json.tmp" "$dir/backup-request.json"
}
# The last request handled, kept so a restarted loop does not run it again.
handled="$(cat "$lib/backup-request.handled" 2>/dev/null || true)"
# A request this loop was running when it stopped did not finish.
grep -q '"status":"running"' "$dir/backup-request.json" 2>/dev/null && request_status failed interrupted
next=$(( $(date +%s) + FIRST ))
schedule
while :; do
  if [ -s /tmp/secrets/backup_request ]; then
    request="$(head -c 128 /tmp/secrets/backup_request)"
    if [ "$request" != "$handled" ]; then
      handled="$request"
      printf '%s' "$request" > "$lib/backup-request.handled"
      # Not during or after a stop ("Sichern und beenden"), nor while a stop
      # waits for the answer to fewer copies: its own backup is the last one,
      # and Paperless stays down for it.
      if grep -qE '"status":"(running|ready|partial)"' "$dir/stop.json" 2>/dev/null; then
        request_status "failed" "stopping"
        continue
      fi
      # A backup that holds the lock now, or one that finished after the
      # request came (this loop's own check ran meanwhile): "check" then.
      mode=run
      flock -n "$dir/backup.lock" true 2>/dev/null || mode=check
      if [ "$dir/backup.json" -nt /tmp/secrets/backup_request ] && grep -q '"status":"done"' "$dir/backup.json"; then mode=check; fi
      request_status running "$mode"
      /usr/local/sbin/paperless-backup "$mode"
      case $? in 0) outcome="done" ;; 2) outcome=partial ;; *) outcome=failed ;; esac
      request_status "$outcome" "$mode" ",\"backup\":$(cat "$dir/backup.json" 2>/dev/null || echo null)"
    fi
  fi
  if [ "$(date +%s)" -ge "$next" ]; then
    fp="$(/usr/local/sbin/paperless-backup fingerprint)"
    if [ "$(due "$fp")" = due ]; then
      /usr/local/sbin/paperless-backup check || echo "paperless-backup-loop: the scheduled backup failed; paperless-backup-due says when it is tried again" >&2
      # The schedule after it (nothing pending once it is backed up).
      due "$fp" > /dev/null
    fi
    next=$(( $(date +%s) + CHECK ))
  fi
  sleep 5
done
