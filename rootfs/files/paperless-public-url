#!/usr/bin/env python3
# paperless-public-url <url>: for curl's --resolve, "host:port:address" of an
# https URL whose host is public (an empty line when the host is an address). Exits 1, saying why, for anything else: not
# https, a loopback, private, link-local or otherwise non-global address, or a
# name that resolves to one. paperless-restore fetches a backup only from a
# host this accepts, at the address it printed.
import ipaddress, socket, sys
from urllib.parse import urlsplit

def refuse(why):
    print(f"paperless-public-url: {why}", file=sys.stderr)
    sys.exit(1)

if len(sys.argv) != 2:
    refuse("usage: paperless-public-url <https url>")
try:
    u = urlsplit(sys.argv[1])
    port = u.port or 443
except ValueError:
    refuse("not a URL")
if u.scheme != "https" or not u.hostname or u.username or u.password:
    refuse("not a plain https URL")
host = u.hostname.rstrip(".").lower()
if host == "localhost" or host.endswith((".localhost", ".local", ".internal", ".lan", ".home.arpa")):
    refuse(f"{host} is not a public host")
try:
    literal = ipaddress.ip_address(host)
except ValueError:
    literal = None
if literal is not None:
    addresses = [literal]
else:
    try:
        infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    except OSError as e:
        refuse(f"{host} does not resolve ({e})")
    addresses = []
    for info in infos:
        a = ipaddress.ip_address(info[4][0].split("%")[0])
        if a not in addresses:
            addresses.append(a)
if not addresses:
    refuse(f"{host} has no address")
for a in addresses:
    m = getattr(a, "ipv4_mapped", None)
    if not a.is_global or (m is not None and not m.is_global):
        refuse(f"{host} points to a non-public address")
if literal is not None:
    print("")
else:
    a = addresses[0]
    print(f"{host}:{port}:{f'[{a}]' if a.version == 6 else a}")
