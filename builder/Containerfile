# The image builder as a container (docs/own-image.md). Pinned by digest where
# it is used, because what runs here is what a person's app attests.
FROM docker.io/library/node:22.21.0-bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends cryptsetup-bin ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/builder
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund --loglevel=error
COPY builder.mjs server.mjs encrypt-image.sh ./
ENV BUILDER_WORK=/work
CMD ["node", "server.mjs"]
